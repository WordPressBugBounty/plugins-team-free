{
  "name": "team-free",
  "version": "4.0.0",
  "description": "Block bundle for Smart Team (free).",
  "main": "apps/blocks/index.js",
  "private": true,
  "scripts": {
    "build": "npm run build:vendor-css && npm run build:blocks && npm run build:dashboard && npm run build:divi5 && npm run check:css-nesting",
    "build:vendor-css": "node scripts/flatten-vendor-css.js",
    "check:css-nesting": "node scripts/check-css-nesting.js",
    "build:blocks": "wp-scripts build apps/blocks/index.js --output-path=dist/editor",
    "build:dashboard": "wp-scripts build apps/dashboard/index.js --output-path=dist/dashboard",
    "build:divi5": "npm --prefix apps/divi-5 run build",
    "install:divi5": "npm --prefix apps/divi-5 install",
    "start": "wp-scripts start apps/blocks/index.js --output-path=dist/editor",
    "start:dashboard": "wp-scripts start apps/dashboard/index.js --output-path=dist/dashboard",
    "lint": "wp-scripts lint-js apps/",
    "lint:fix": "wp-scripts lint-js apps/ --fix",
    "format": "wp-scripts format apps/",
    "package": "node build-zip.js",
    "release": "npm run build && npm run package",
    "test": "npm run test:unit-js && npm run test:php",
    "test:php": "php tests/php/run.php",
    "test:unit-js": "wp-scripts test-unit-js --config jest-unit.config.js",
    "test:e2e": "wp-scripts test-playwright --config playwright.config.ts",
    "test:e2e:ui": "wp-scripts test-playwright --config playwright.config.ts --ui",
    "test:e2e:headed": "wp-scripts test-playwright --config playwright.config.ts --headed",
    "test:e2e:debug": "wp-scripts test-playwright --config playwright.config.ts --debug",
    "test:e2e:start": "wp-env start",
    "test:e2e:stop": "wp-env stop"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@wordpress/api-fetch": "^6.0.0",
    "@wordpress/block-editor": "^12.0.0",
    "@wordpress/blocks": "^12.0.0",
    "@wordpress/components": "^25.0.0",
    "@wordpress/data": "^9.0.0",
    "@wordpress/e2e-test-utils-playwright": "^1.54.0",
    "@wordpress/element": "^5.0.0",
    "@wordpress/env": "^10.39.0",
    "@wordpress/eslint-plugin": "^22.22.0",
    "@wordpress/i18n": "^4.0.0",
    "@wordpress/icons": "^9.0.0",
    "@wordpress/prettier-config": "^4.0.0",
    "@wordpress/scripts": "^30.0.0",
    "archiver": "^7.0.1",
    "cssnano": "^6.1.2",
    "postcss": "^8.5.32",
    "postcss-nesting": "^13.0.2",
    "prettier": "^3.2.5",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "classnames": "^2.5.1",
    "react-hot-toast": "^2.6.1",
    "react-select": "^5.10.2",
    "swiper": "^12.2.0"
  }
}
